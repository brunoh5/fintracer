{
  "name": "@fintracer/api",
  "version": "0.0.1",
  "main": "server.mjs",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run services:up && tsx watch src/server.ts",
    "services:up": "docker compose -f src/infra/compose.yaml up -d",
    "build": "tsdown src/*",
    "preview": "node --env-file=.env dist/server.mjs",
    "start": "node --env-file=.env dist/server.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "dotenv": "18.0.8",
    "express": "5.3.0",
    "jsonwebtoken": "9.0.3",
    "node-pg-migrate": "9.0.0",
    "pg": "8.20.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "tsdown": "0.23.1"
  }
}